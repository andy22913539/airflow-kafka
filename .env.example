# =========================
# Timezone
# =========================
TZ=Asia/Taipei

# =========================
# Airflow
# =========================
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_WITH_FERNET
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=airflow

# =========================
# MySQL application DB
# =========================
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=recipe_ai
MYSQL_USER=recipe_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP
MYSQL_PORT=3307

# =========================
# MongoDB application DB
# =========================
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT
MONGO_DATABASE=recipe_ai
MONGO_APP_USER=recipe_app
MONGO_APP_PASSWORD=CHANGE_ME_MONGO_APP
MONGO_PORT=27018

# =========================
# Kafka
# =========================
KAFKA_PORT=9094
KAFKA_JOB_TOPIC=crawler_jobs
KAFKA_RESULT_TOPIC=ytower_recipe_results
KAFKA_JOB_PARTITIONS=5
KAFKA_RESULT_PARTITIONS=4

# =========================
# YTower crawler
# Leave blank for manual-only Airflow runs.
# Example every 7 days: 0 0 */7 * *
# =========================
YTOWER_DAG_SCHEDULE=
MAX_SEQ_NUMBER=5000
MAX_NOT_FOUND_LIMIT=50
REQUEST_TIMEOUT=20
REQUEST_RETRIES=3
MAX_POLL_INTERVAL_MS=28800000
COOLDOWN_SUCCESS_COUNT=50
CRAWL_SLEEP_MIN=2.5
CRAWL_SLEEP_MAX=5.0
DIRECT_CRAWL_SLEEP_MIN=4.0
DIRECT_CRAWL_SLEEP_MAX=8.0
DIRECT_BLOCK_COOLDOWN_SECONDS=900
DIRECT_BLOCK_MAX_RETRIES=2
NOT_FOUND_SLEEP_MIN=0.5
NOT_FOUND_SLEEP_MAX=1.2
COOLDOWN_SLEEP_MIN=10
COOLDOWN_SLEEP_MAX=20

# =========================
# Dynamic free proxy pool (Taiwan first)
# No PROXY_1..PROXY_4 maintenance is required.
# proxy-manager discovers, validates and stores usable TW proxies in MongoDB.
# =========================
PROXY_COUNTRY_CODE=TW
PROXY_DISCOVERY_INTERVAL=1800

PROXY_VALIDATION_TIMEOUT=15
PROXY_VALIDATION_WORKERS=20
PROXY_MAX_VALIDATE_PER_CYCLE=200

# 免費 Proxy 先不要限制 1 秒
PROXY_MAX_LATENCY_MS=10000

# TCP 快速探測
PROXY_TCP_TIMEOUT=3

PROXY_MAX_FAILURES=3
PROXY_LEASE_SECONDS=1800
PROXY_WAIT_SECONDS=15
MAX_PROXY_SWITCHES_PER_SEQ=5
PROXY_STALE_HOURS=12
# =========================
# Mongo writer
# =========================
MONGO_BATCH_SIZE=50
